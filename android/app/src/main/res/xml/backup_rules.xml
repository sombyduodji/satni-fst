<?xml version="1.0" encoding="utf-8"?>
<!-- Varmuuskopio (Android 11 ja vanhemmat, android:fullBackupContent): vain asetukset, historia ja suosikit
     (WebViewin localStorage) sekä sovelluksen omat asetustiedostot. Ei sanakirjaa, välimuistia eikä tekstintunnistuksen
     kuvia (cache/ocr; välimuistia ei varmuuskopioida koskaan). Samat säännöt: data_extraction_rules.xml. -->
<full-backup-content>
    <include domain="root" path="app_webview/Default/Local Storage/" />
    <include domain="sharedpref" path="." />
</full-backup-content>
